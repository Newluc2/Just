# ============================================
# Just - Variables d'environnement Docker
# Copier ce fichier en .env et adapter les valeurs
# ============================================

# Secret JWT (CHANGER EN PRODUCTION !)
JWT_SECRET=just_super_secret_key_change_me_in_production

# URL du client (utilisée pour le CORS backend)
# Mettre l'URL publique d'accès (ex: http://monip, http://mondomaine.com)
CLIENT_URL=http://localhost:5173,https://just.newluc.top

# Port exposé sur le host (le frontend+proxy Nginx)
APP_PORT=80

# URL de l'API vue depuis le navigateur
# En mode Docker avec Nginx reverse proxy, on utilise /api (chemin relatif)
VITE_API_URL=/api

# URL du serveur Socket.io vue depuis le navigateur
# Laisser vide = même origine que la page (fonctionne avec le reverse proxy Nginx)
VITE_SOCKET_URL=

# Token Cloudflare Tunnel (optionnel)
# Permet un accès public sans redirection de port:
# docker compose --profile public up -d
CLOUDFLARE_TUNNEL_TOKEN=
